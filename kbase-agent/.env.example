# 模型（默认 DeepSeek，OpenAI 兼容层实现模型无关）
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0

# 成本估算（元/百万 token，仅用于 trace /api/runs 展示，按实际套餐改）
LLM_PRICE_INPUT=2.0
LLM_PRICE_OUTPUT=8.0

# 想切换 GLM / Qwen 时只需改下面两行：
# DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DEEPSEEK_MODEL=glm-4-plus
# 或
# DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_MODEL=qwen-plus

# embedding：默认 FastEmbed（ONNX，免 torch，开箱即用），模型首次使用会自动下载
EMBED_BACKEND=fastembed
FASTEMBED_MODEL=BAAI/bge-small-zh-v1.5
# 想升级到 bge-m3（更准、需 torch）：EMBED_BACKEND=flagembedding 并 pip install -e ".[embed]"
# 注意：换 embedding 模型后要删除 data/chroma/ 重新建索引
# EMBEDDING_MODEL=bge-m3

# rerank：opt-in（FlagReranker 依赖 torch）。开 true 前先 pip install -e ".[embed]"
RERANK_ENABLED=false
RERANK_MODEL=bge-reranker-v2-m3

# 向量库（开发用 Chroma）
CHROMA_PATH=./data/chroma
COLLECTION_NAME=kbase

# Agent 护栏：可选覆盖 LangGraph recursion_limit（防死循环的第二道保险）。
# 默认按 AgentLimits.max_steps 自动推导（2×max_steps+5 = 55），保证 prompt 承诺的
# 25 步工具调用不被框架提前掐断；想更早兜底死循环可设小，例如：
# MAX_RECURSION=30
