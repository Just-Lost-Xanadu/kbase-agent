# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# 环境与密钥
.env
.env.*
# 模板文件需要进仓库（README 指引用户复制它生成 .env）
!.env.example

# 数据与索引（项目位于子目录 kbase-agent/，用 **/ 前缀匹配任意层级）
**/data/chroma/
**/data/raw/
**/data/business/
*.db
*.sqlite
# SQLite WAL 运行期临时文件（服务运行/测试时产生，绝不能入库）
*.sqlite-wal
*.sqlite-shm
*-wal
*-shm

# 评测报告默认不入库：只保留被显式选为"基线/回归证据"的报告
# （当前入库的 baseline.json / fullrun-verify.json 是手动 git add 进来的，
#   日后新增的报告会被这条规则挡在仓库外，避免 docs/eval-reports/ 无限膨胀）
kbase-agent/docs/eval-reports/*.json

# IDE
.idea/
.vscode/
.DS_Store
